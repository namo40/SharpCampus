<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cleared so the multi-targeting below beats the single framework Directory.Build.props sets. -->
    <TargetFramework />
    <!-- netstandard2.1 keeps the contracts loadable from Unity; net10.0 is what the servers reference. -->
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <!-- Consumed by MagicOnion JSON transcoding Swagger to document the generated HTTP endpoints. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MagicOnion.Abstractions" />
    <!-- The MessagePack options the contracts need are shared by both servers and the client. -->
    <PackageReference Include="MagicOnion.Serialization.MessagePack" />
    <!-- Unconditional, unlike EF Core below: MasterMemory runs on the Unity-facing target too. -->
    <PackageReference Include="MasterMemory" />
    <PackageReference Include="MessagePack" />
    <!-- Inbox on net10.0, a package on netstandard2.1: the master data importer and the generated
         value object converters need it on both. -->
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Ulid" />
    <PackageReference Include="Ulid.MessagePack" />
    <PackageReference Include="UnitGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- The duel contract speaks the simulation's own enums, and the client-side replica replays its
         events, so the pure netstandard2.1 simulation travels with the contracts. -->
    <ProjectReference Include="..\SharpCampus.GameCore\SharpCampus.GameCore.csproj" />
  </ItemGroup>

</Project>
